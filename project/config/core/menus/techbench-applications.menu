      <Menuname show_empty="true">GPU</Menuname>
      <Menuname show_empty="true">Charging</Menuname>
      <Menuname show_empty="true">Wi-Fi</Menuname>
      <Menuname show_empty="true">Camera</Menuname>
      <Menuname show_empty="true">Speakers &amp; Microphone</Menuname>
      <Menuname show_empty="true">USB Ports</Menuname>
      <Menuname show_empty="true">Bluetooth</Menuname>
      <Menuname show_empty="true">Ethernet</Menuname>
      <Menuname show_empty="true">HDMI / External Display</Menuname>
      <Menuname show_empty="true">Headphone Jack</Menuname>
      <Menuname show_empty="true">SD Card Reader</Menuname>
    </Layout>
  </Menu>
  <Layout>
    <Menuname>Settings</Menuname>
    <Menuname>Accessories</Menuname>
    <Menuname>Internet</Menuname>
    <Menuname>Multimedia</Menuname>
    <Menuname>System</Menuname>
    <Menuname>Testing</Menuname>
    <Separator />
    <Filename>techbench-logout.desktop</Filename>
  </Layout>
  <Include>
    <Filename>techbench-logout.desktop</Filename>
  </Include>
</Menu>