<?xml version='1.0' encoding='UTF-8'?>
<Menu>
  <Name>Applications</Name>
  <DefaultAppDirs />
  <DefaultDirectoryDirs />
  <Menu>
    <Name>Settings</Name>
    <Directory>xfce-settings.directory</Directory>
    <Include>
      <Category>Settings</Category>
    </Include>
  </Menu>
  <Menu>
    <Name>Accessories</Name>
    <Directory>xfce-accessories.directory</Directory>
    <Include>
      <Category>Utility</Category>
    </Include>
  </Menu>
  <Menu>
    <Name>Internet</Name>
    <Directory>xfce-network.directory</Directory>
    <Include>
      <Category>Network</Category>
    </Include>
  </Menu>
  <Menu>
    <Name>Multimedia</Name>
    <Directory>xfce-multimedia.directory</Directory>
    <Include>
      <Category>AudioVideo</Category>
    </Include>
  </Menu>
  <Menu>
    <Name>System</Name>
    <Directory>xfce-system.directory</Directory>
    <Include>
      <Category>System</Category>
    </Include>
  </Menu>
  <Menu>
    <Name>Testing</Name>
    <DefaultLayout show_empty="true" inline="false" inline_limit="0" inline_header="true" inline_alias="false">
      <Merge type="menus" />
      <Merge type="files" />
    </DefaultLayout>
    <Menu>
      <Name>Hardware &amp; Specs</Name>
      <Include>
        <Category>X-TechBench-HardwareSpecs</Category>
      </Include>
    </Menu>
    <Menu>
      <Name>Storage</Name>
      <Include>
        <Category>X-TechBench-Storage</Category>
      </Include>
    </Menu>
    <Menu>
      <Name>Battery</Name>
      <Include>
        <Category>X-TechBench-Battery</Category>
      </Include>
    </Menu>
    <Menu>
      <Name>Temperatures &amp; Cooling</Name>
      <Include>
        <Category>X-TechBench-TemperaturesCooling</Category>
      </Include>
    </Menu>
    <Menu>
      <Name>Memory</Name>
      <Include>
        <Category>X-TechBench-Memory</Category>
      </Include>
    </Menu>
    <Menu>
      <Name>Display</Name>
      <Include>
        <Category>X-TechBench-Display</Category>
      </Include>
    </Menu>
    <Menu>
      <Name>Keyboard &amp; Touchpad</Name>
      <Include>
        <Category>X-TechBench-KeyboardTouchpad</Category>
      </Include>
    </Menu>
    <Menu>
      <Name>CPU</Name>
      <Include>
        <Category>X-TechBench-CPU</Category>
      </Include>
    </Menu>
    <Menu>
      <Name>GPU</Name>
      <Include>
        <Category>X-TechBench-GPU</Category>
      </Include>
    </Menu>
    <Menu>
      <Name>Charging</Name>
      <Include>
        <Category>X-TechBench-Charging</Category>
      </Include>
    </Menu>
    <Menu>
      <Name>Wi-Fi</Name>
      <Include>
        <Category>X-TechBench-WiFi</Category>
      </Include>
    </Menu>
    <Menu>
      <Name>Camera</Name>
      <Include>
        <Category>X-TechBench-Camera</Category>
      </Include>
    </Menu>
    <Menu>
      <Name>Speakers &amp; Microphone</Name>
      <Include>
        <Category>X-TechBench-SpeakersMicrophone</Category>
      </Include>
    </Menu>
    <Menu>
      <Name>USB Ports</Name>
      <Include>
        <Category>X-TechBench-USBPorts</Category>
